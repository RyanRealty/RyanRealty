#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

# Fast marker check ONLY — the heavy chain moved to `npm run push`.
#
# WHY: git establishes the ssh connection to github.com and advertises refs
# BEFORE running pre-push. The old in-hook chain (ci:gates + next build,
# ~10 min) idled that connection out, and the pack write died with SIGPIPE
# (exit 141) even with every gate green — observed twice on 2026-07-17.
# scripts/push-with-gates.sh now runs ci:gates + the Turbopack build BEFORE
# invoking git push, then stamps <git-dir>/rr-gates-marker with the HEAD
# tree hash + timestamp. This hook verifies the pushed tree matches a fresh
# marker in milliseconds, so the connection never idles.
#
# SKIP_LOCAL_GATES=1 bypasses this hook (same escape hatch as before).

if [ "$SKIP_LOCAL_GATES" = "1" ]; then
  echo "Skipping local quality gates (SKIP_LOCAL_GATES=1)."
  exit 0
fi

marker="$(git rev-parse --git-dir)/rr-gates-marker"
max_age_min="${GATES_MARKER_MAX_AGE_MIN:-240}"

fail() {
  echo "" >&2
  echo "✗ pre-push: $1" >&2
  echo "" >&2
  echo "  Gates run BEFORE the push connection now (a long in-hook chain" >&2
  echo "  kills the push with SIGPIPE). Use the wrapper:" >&2
  echo "" >&2
  echo "    npm run push            # ci:gates + build + stamp + git push" >&2
  echo "    npm run push -- <args>  # extra args pass through to git push" >&2
  echo "" >&2
  echo "  Already ran the chain by hand? Stamp then push within ${max_age_min} min:" >&2
  echo "    npm run gates:stamp && git push" >&2
  echo "  Escape hatch: SKIP_LOCAL_GATES=1 git push" >&2
  exit 1
}

[ -f "$marker" ] || fail "no gates marker — the gate chain has not certified this tree"

marker_tree=$(cut -d' ' -f1 "$marker")
marker_ts=$(cut -d' ' -f2 "$marker")
now=$(date +%s)
case "$marker_ts" in
  ''|*[!0-9]*) fail "gates marker is malformed ($marker)" ;;
esac
age_min=$(( (now - marker_ts) / 60 ))
[ "$age_min" -le "$max_age_min" ] || fail "gates marker is ${age_min} min old (max ${max_age_min}) — re-run the chain"

# stdin: "<local_ref> <local_sha> <remote_ref> <remote_sha>" per ref being
# pushed. Every non-delete ref's tree must be the exact tree the chain passed.
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue   # ref delete — nothing to gate
  push_tree=$(git rev-parse "$local_sha^{tree}" 2>/dev/null) || fail "cannot resolve tree for $local_sha ($local_ref)"
  if [ "$push_tree" != "$marker_tree" ]; then
    fail "tree of $local_ref ($push_tree) != gated tree ($marker_tree) — commits changed since the chain ran"
  fi
done

echo "✓ pre-push: gates marker fresh (${age_min} min) and tree matches — push proceeds."
exit 0
