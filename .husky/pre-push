#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

# SKIP_LOCAL_GATES=1 bypasses this hook (same escape hatch as before).

if [ "$SKIP_LOCAL_GATES" = "1" ]; then
  echo "Skipping local quality gates (SKIP_LOCAL_GATES=1)."
  exit 0
fi

# Full static gate chain (Matt directive 2026-07-17) — the same ~120-gate
# ci:gates chain GitHub Actions runs, now enforced BEFORE the push so a
# session that forgets to run it locally cannot land a gate regression on
# main (ci:hydration-safety, ci:design-tokens, ci:composer-discipline,
# ci:crm-sms-safety, ci:admin-responsive, …).
#
# ci:gates includes ci:commit-compiles (G46, --head mode) — it REPLACES the
# standalone `node scripts/check-commit-compiles.mjs --head` call that used
# to live here; keeping both would run the isolated tsc pass twice.
#
# NOTE: most gates scan the working tree, not the pushed commits. On a box
# running concurrent agent sessions, uncommitted work from another session
# can fail a gate here. That is the intended tradeoff: nothing red reaches
# main.

echo "Pre-push: full ci:gates static chain (~120 gates)…"
npm run ci:gates || {
  echo ""
  echo "✗ ci:gates FAILED — push blocked. Fix the failing gate before pushing."
  echo "  SKIP_LOCAL_GATES=1 bypasses (only if you know why)."
  exit 1
}
echo "✓ ci:gates OK"

# G47 — production build gate (Turbopack, matches Vercel)
#
# WHY: a "use server" / RSC build break passes tsc (G46 above), ci:gates, AND a
# webpack build, but FAILS the Turbopack build Vercel runs (Next 16 defaults to
# Turbopack) — then silently never deploys while the last good deploy keeps
# serving. This broke production for the entire CRM Wave 3->9 series with every
# gate green. tsc cannot catch this class; only an actual Turbopack build can.
# Pushes go straight to main (no PR), so this local hook is the only pre-main
# chokepoint. (See docs/plans/crm-golive-execution-2026-06-25.md.)
#
# Skips when the push touches no buildable code (docs / json / changelog only)
# so doc pushes stay fast. SKIP_LOCAL_GATES=1 bypasses everything.

if git rev-parse --abbrev-ref @{u} >/dev/null 2>&1; then
  CHANGED=$(git diff --name-only @{u}..HEAD 2>/dev/null)
else
  CHANGED="__force_build__"   # no upstream tracking — build to be safe
fi

if [ -z "$CHANGED" ]; then
  echo "Pre-push: nothing ahead of upstream — skipping build."
elif [ "$CHANGED" = "__force_build__" ] || printf '%s\n' "$CHANGED" | grep -qE '\.(ts|tsx|js|jsx|mjs|cjs|css)$|(^|/)next\.config|(^|/)package\.json|(^|/)tsconfig'; then
  echo "Pre-push: production build (Turbopack, matches Vercel) — catches use-server/RSC breaks tsc misses…"
  # Next's type-check phase OOMs at Node's default ~4GB heap at this repo's size
  # (observed 2026-07-14: SIGABRT mid "Running TypeScript"). 8GB fits the 16GB Mac mini.
  NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=8192}"
  export NODE_OPTIONS
  npm run build || {
    echo ""
    echo "✗ next build FAILED — this commit would ERROR on Vercel and silently never deploy."
    echo "  Fix the build before pushing. SKIP_LOCAL_GATES=1 bypasses (only if you know why)."
    exit 1
  }
  echo "✓ next build OK"
else
  echo "Pre-push: only non-buildable files changed — skipping build."
fi
