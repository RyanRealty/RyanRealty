#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

# G46 — commit self-containment gate
#
# This is the ONLY check that runs here.  The old body (ci:gates) was
# replaced because ci:gates operates on the working tree — it can silently
# pass when the commit is broken (working tree has symbols the commit lacks).
#
# check-commit-compiles.mjs materializes the actual HEAD tree into a temp dir
# (git archive HEAD | tar -x), symlinks node_modules, and type-checks it in
# isolation.  This is tree-state-INDEPENDENT: it sees exactly what was
# committed, nothing more.
#
# ci:gates still runs in GitHub Actions CI on every push, so the full suite
# is not skipped — it just runs at the right moment (after code lands) rather
# than on the working tree before push.
#
# SKIP_LOCAL_GATES=1 bypasses this hook (same escape hatch as before).

if [ "$SKIP_LOCAL_GATES" = "1" ]; then
  echo "Skipping local quality gates (SKIP_LOCAL_GATES=1)."
  exit 0
fi

node scripts/check-commit-compiles.mjs --head
