#!/usr/bin/env bash
# Pre-commit gates. Run cheap structural checks before any heavy tests.

# husky's runner invokes hooks as `sh -e "$hook"`, which ignores the shebang
# above. Where /bin/sh is dash (Debian, Ubuntu, most Linux CI images) that shell
# has no `set -o pipefail`, so this hook aborted with "Illegal option -o
# pipefail" before running a single gate — the commit failed for a shell reason
# while every gate was still green. Re-exec under bash so the pipefail semantics
# the piped gates below depend on actually hold, instead of dropping pipefail
# and letting a mid-pipeline failure pass silently.
[ -z "${BASH_VERSION:-}" ] && exec bash "$0" "$@"

set -eo pipefail

# G74 — an oversized review screenshot must never enter history. Git is
# append-only, so unlike every other gate this one has no second chance at
# push time: once a 10 MB PNG is in a commit, every clone pays for it forever.
# It is a stat() walk of ~80 files, so it costs nothing to run here.
npm run --silent ci:shot-weight

# UNIT tests only. The *.int.test.ts project hits live Supabase; under the old
# `npm test` this hook ran the whole suite on every commit — 5-10 minutes, and
# it flaked whenever a concurrent Vercel build saturated the connection pool
# (measured 2026-07-29: 45 of 52 connections active, 19 pure timeouts, zero
# assertion failures). Integration tests still run: `npm run push` builds and
# gates before any ref moves, and CI runs the full suite on GitHub runners.
# Commit fast, verify hard at the boundary that actually ships.
npm run test:unit
