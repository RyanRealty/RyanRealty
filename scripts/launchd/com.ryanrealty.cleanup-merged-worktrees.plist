<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ryanrealty.cleanup-merged-worktrees</string>
  <key>Comment</key>
  <string>Hourly: remove finished Ryan Realty worktrees on the Mini. Load once with scripts/install-cleanup-launchd.sh. The script refuses dirty, unpushed, stashed, recently-touched, and in-use checkouts.</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RR_CLEANUP_SCRIPT__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RR_CLEANUP_REPO__</string>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/rr-cleanup-merged-worktrees.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/rr-cleanup-merged-worktrees.log</string>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
