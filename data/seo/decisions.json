      "decided": "Matt 2026-09-24",
      "why": "Same rule."
    },
    {
      "id": "resort-caldera-springs",
      "path": "/communities/caldera-springs",
      "expect": {
        "status": 200,
        "index": true,
        "canonical": "self",
        "title": "^Caldera Springs real estate"
      },
      "decided": "Matt 2026-09-24",
      "why": "Same rule."
    },
