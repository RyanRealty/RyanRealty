    {
      "id": "aeo-market-lead-and-tables",
      "path": "/housing-market/bend",
      "expect": {
        "status": 200,
        "html": [
          "id=\"takeaways\"",
          "class=\"v3-takeaways__lead\"",
          "class=\"v3-chart__table\"",
          "Are home prices going up in Bend\\?"
        ]
      },
      "decided": "Matt 2026-10-04",
      "why": "AEO: the short answer right after the opening, every chart's numbers as a real table, and the appreciation question people search."
    }
  ]
