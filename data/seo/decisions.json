      "id": "resort-eagle-crest",
      "path": "/communities/eagle-crest",
      "expect": {
        "status": 200,
        "index": true,
        "canonical": "self",
        "title": "^Eagle Crest real estate"
      },
      "decided": "Matt 2026-09-24",
      "why": "Same rule."
    },
    {
      "id": "top-blog-indexed",
      "path": "/blog/sunriver-year-round-living-vs-vacation",
      "expect": {
        "status": 200,
        "index": true,
        "canonical": "self"
      },
      "decided": "GSC 2026-10-04",
      "why": "Top organic page by clicks (44 in 90 days). Losing it is a visible traffic drop."
    },
    {
      "id": "aeo-city-takeaways",
      "path": "/cities/bend",
      "expect": {
        "status": 200,
        "html": [
          "id=\"takeaways\"",
          "class=\"v3-takeaways__lead\""
        ]
      },
      "decided": "Matt 2026-10-04",
      "why": "AEO: the short answer (V3Takeaways) after the opening, in the served HTML, so answer engines cite a real answer from the top of the page."
    },
    {
      "id": "aeo-community-takeaways",
      "path": "/communities/sunriver",
      "expect": {
        "status": 200,
        "html": [
          "id=\"takeaways\"",
          "class=\"v3-takeaways__lead\""
        ]
